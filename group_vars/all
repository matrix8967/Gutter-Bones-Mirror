---
# ====================
# GUTTER BONEZ GLOBAL VARIABLES
# ====================
# Basic configuration for testing and development

# SSH Configuration
ansible_ssh_common_args: '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
ansible_ssh_timeout: 30
ansible_ssh_private_key_file: "~/.ssh/id_rsa"

# Default User Settings
default_user: azazel
default_port: 8967

# System Settings
timezone: "America/New_York"
ntp_servers:
  - "pool.ntp.org"
  - "time.google.com"

# DNS Settings
default_dns_servers:
  - "76.76.19.19"    # Control D
  - "76.76.76.76"    # Control D
  - "1.1.1.1"        # Cloudflare backup
  - "8.8.8.8"        # Google backup

# Control D Settings
controld_endpoint: "verify.controld.com"
ctrld_config_path: "/etc/ctrld/ctrld.toml"

# Package Management
common_packages:
  - curl
  - wget
  - htop
  - vim
  - git
  - unzip
  - tmux

# Security Settings
disable_root_login: true
password_authentication: false
permit_empty_passwords: false

# Logging
log_level: INFO
syslog_facility: local0

# Environment
environment_name: "gutter_bonez_lab"
domain_name: "darkfort.local"

# Network Settings
production_subnet: "10.10.10.0/24"
vm_subnet: "192.168.100.0/24"

# Backup Settings
backup_retention_days: 30
backup_path: "/opt/backups"

# Update Settings
auto_update: false
reboot_required: false
